# Database
DATABASE_URL="postgresql://user:password@localhost:5432/decision_lab?schema=public"

# Microsoft Azure AI Foundry Model Router
FOUNDRY_PROJECT_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>"
FOUNDRY_ROUTER_DEPLOYMENT="model-router"
FOUNDRY_API_VERSION="2024-06-01"
AI_REQUEST_TIMEOUT_MS="30000"

# Application & Auth
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"
RATE_LIMIT_STORE_URL="redis://localhost:6379"
